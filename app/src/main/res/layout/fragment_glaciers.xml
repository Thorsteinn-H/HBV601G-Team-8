<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/glacierTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap a glacier on the map"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/icelandMapImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/iceland_map"
                android:contentDescription="Map of Iceland"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnDrangajokull"
                android:layout_width="30dp"
                android:layout_height="29dp"
                android:layout_marginStart="84dp"
                android:layout_marginTop="116dp"
                android:backgroundTint="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📍"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btnSnaefellsjokull"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="48dp"
                android:layout_marginTop="192dp"
                android:backgroundTint="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📍"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btnLangjokull"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="136dp"
                android:layout_marginTop="212dp"
                android:backgroundTint="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📍"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btnHofsjokull"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="168dp"
                android:layout_marginTop="192dp"
                android:backgroundTint="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📍"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btnEyjafjallajokull"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="144dp"
                android:layout_marginTop="256dp"
                android:backgroundTint="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📍"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btnMyrdalsjokull"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="180dp"
                android:layout_marginTop="248dp"
                android:backgroundTint="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📍"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btnVatnajokull"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="224dp"
                android:layout_marginTop="212dp"
                android:backgroundTint="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📍"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/textGlaciers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a glacier from the map."
            android:textSize="18sp"
            android:lineSpacingExtra="8dp" />

    </LinearLayout>
</ScrollView>